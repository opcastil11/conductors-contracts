# Deployer key (funded on the target network). NEVER commit the real value.
PRIVATE_KEY=

# RPC endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Verification
BASESCAN_API_KEY=
ARBISCAN_API_KEY=

# DOBX — the quote token of every agent curve.
# Leave EMPTY on the very first deploy of a network: deploy.js mints it and sends the whole
# supply to PLATFORM_TREASURY. On every run after that, set it to the address that deploy
# printed — otherwise a second DOBX is minted and the curves stop sharing a quote token.
DOBX_ADDRESS=

# Platform treasury: receives the DOBX supply, launch fees and leftover inventory at graduation.
PLATFORM_TREASURY=

# Address allowed to flip KycRegistry approvals (the gate at the A→B crossing).
# Defaults to the deployer if unset.
KYC_ATTESTOR=
